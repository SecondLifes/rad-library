# =============================================================================
# .gitignore — Delphi AI Spec-Kit
# =============================================================================

# --- Delphi Build Artifacts ---
*.dcu
*.exe
*.dll
*.bpl
*.dcp
*.drc
*.map
*.obj
*.o
*.a

# --- IDE Temporary / Generated Files ---
*.local
*.identcache
*.stat
*.~*
*.tvsconfig
__history/
__recovery/

# --- Build / Output Directories ---
Win32/
Win64/
x64/
x86/
Debug/
Release/
build/
dist/
output/

# --- Dependencies and Caches ---
node_modules/
.venv/
.pytest_cache/
.mypy_cache/
modules/

# --- Sensitive / Credential Files ---
*.key
*.pfx
*.p12
.env
.env.*

# --- Large / Noisy Files ---
*.log
*.dmp
*.bak
*.tmp

# --- OS Artifacts ---
Thumbs.db
.DS_Store

# --- Scratch test ciktilari ---
# src/test/scratch/* altindaki sondalarin KAYNAKLARI (.dpr, .bat) commit edilir;
# calistiklarinda urettikleri her sey edilmez. Bunlar olcum kalintisi: her kosuda
# degisirler ve diff'i kirletip gercek degisikligi gizlerler.
src/test/scratch/*/bin/
src/test/scratch/*/bin64/
src/test/scratch/**/test_log.txt
src/test/scratch/**/build_log.txt
*.rsm

# Delphi IDE'nin proje basina yazdigi yerel derleyici secenekleri - makineye ozgu.
*.optset

# rad.cache / rad.config testleri calisirken birim dosyalarinin yanina yazilir.
# Kaynak degil, cikti.
src/core/Cache.json
src/core/Config.json

# --- Local dev convenience scripts (not part of the published kit) ---
update.bat
analysis/
.serena

# --- Generated skill links (never committed) ---
# tools/generate-ai-configs.ps1 creates one junction/symlink per .agents/skills/*
# here, because Claude Code only discovers skills under .claude/skills/. These
# are machine-local links, regenerated by the script on any clone. They must NOT
# be committed: git does not store a junction — it would follow it and commit a
# full second copy of every skill, which is exactly the duplicate source of
# truth this whole scheme exists to prevent.
.claude/skills/

# MCP sunucu ayarı — MAKİNEYE ÖZGÜ mutlak yol içerir (code-intel kitinin
# konumu her makinede farklı). Commit edilirse başka bir klonda yanlış yola
# işaret eder ve sunucu sessizce başlamaz.
.mcp.json
