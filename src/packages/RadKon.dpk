package RadKon;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'RAD Library runtime'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  dbrtl,
  vclimg,
  vclwinx,
  dxCoreRS37,
  cxLibraryRS37,
  dxGDIPlusRS37,
  dac370,
  tdsprovider370,
  dxServerModeRS37,
  dxSpreadSheetCoreRS37,
  cxGridRS37,
  cxTreeListRS37,
  dxBarRS37,
  cxTreeListdxBarPopupMenuRS37,
  unidacvcl370,
  dacvcl370,
  cxVerticalGridRS37,
  vquery370,
  Jcl,
  JvCore,
  JvStdCtrls,
  dxSkinsCoreRS37,
  Dext.Core,
  TMSVCLUIPackPkg;

contains
  Kisayol.Edit in '..\share\Kisayol.Edit.pas' {Kisayol_Edit},
  Permission.Edit in '..\component\Permission.Edit.pas' {Permission_Edit: TFrame},
  rad.db in '..\component\rad.db.pas',
  rad.rtl in '..\component\rad.rtl.pas',
  rad.vcl in '..\component\rad.vcl.pas',
  rad.tms.formtabs in '..\component\rad.tms.formtabs.pas',
  rad.cipher in '..\core\rad.cipher.pas',
  rad.formstate.core in '..\core\rad.formstate.core.pas',
  rad.formstate.store in '..\core\rad.formstate.store.pas',
  rad.formstate.component in '..\component\rad.formstate.component.pas',
  rad.formstate.dev in '..\component\rad.formstate.dev.pas',
  rad.formstate.rules in '..\component\rad.formstate.rules.pas',
  rad.formstate.customizer in '..\component\rad.formstate.customizer.pas',
  rad.formstate in '..\component\rad.formstate.pas',
  rad.formstate.uni in '..\vendor\unidac\rad.formstate.uni.pas',
  Help.DB in '..\core\Help.DB.pas',
  rad.permission in '..\core\rad.permission.pas',
  Help.uni in '..\core\Help.uni.pas',
  rad.cmd in '..\core\rad.cmd.pas',
  rad.eventbus in '..\core\rad.eventbus.pas',
  rad.thread in '..\core\rad.thread.pas',
  rad.utils in '..\core\rad.utils.pas',
  rad.core in '..\core\rad.core.pas',
  Rad.Dev in '..\component\Rad.Dev.pas',
  rad.cache in '..\core\rad.cache.pas',
  rad.config in '..\core\rad.config.pas',
  rad.sqlfilter in '..\core\rad.sqlfilter.pas',
  rad.customfield in '..\core\rad.customfield.pas',
  rad.script in '..\core\rad.script.pas',
  rad.desktop.core in '..\core\rad.desktop.core.pas',
  rad.desktop.commands in '..\core\rad.desktop.commands.pas',
  rad.desktop.widgets in '..\core\rad.desktop.widgets.pas',
  rad.desktop.store in '..\core\rad.desktop.store.pas',
  rad.desktop.paint in '..\component\rad.desktop.paint.pas',
  rad.desktop.view in '..\component\rad.desktop.view.pas',
  rad.desktop.dialogs in '..\component\rad.desktop.dialogs.pas' {RadDeskMenus: TDataModule},
  rad.desktop.picker in '..\component\rad.desktop.picker.pas' {RadDeskPickerForm},
  rad.desktop.sources in '..\component\rad.desktop.sources.pas',
  rad.desktop in '..\component\rad.desktop.pas',
  rad.search.match in '..\core\rad.search.match.pas',
  rad.search.core in '..\core\rad.search.core.pas',
  rad.search.popup in '..\component\rad.search.popup.pas',
  rad.search in '..\component\rad.search.pas',
  rad.dev.customfields in '..\component\rad.dev.customfields.pas' {RadCustomFieldsFrame: TFrame},
  rad.dev.customfielddesigner in '..\component\rad.dev.customfielddesigner.pas' {RadCustomFieldDesigner};

end.

